# 本番/ステージング用環境変数
# コピーして使う: cp .env.production.example .env.production
# ※ .env.production は git 管理外（.gitignore に追加済み）

POSTGRES_USER=giinscore
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=giinscore

# --- ローカル検証時 ---
HTTP_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# --- VPS本番時（上の3行をコメントアウトしてこちらを使う） ---
# HTTP_PORT=80
# NEXT_PUBLIC_API_URL=https://your-domain.example.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://your-domain.example.com
# CORS_ORIGINS=https://your-domain.example.com
